NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Settings -> API -> Project API keys -> service_role/secret.
# Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Resend API key - used both as Supabase Auth's SMTP password
# and for emails we compose and send ourselves (e.g. password-changed).
RESEND_API_KEY=
